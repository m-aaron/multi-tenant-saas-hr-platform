{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --conditions @dev src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "imports": {
    "#config/*.js": {
      "@dev": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#modules/*.js": {
      "@dev": "./src/modules/*.ts",
      "default": "./dist/modules/*.js"
    },
    "#shared/*.js": {
      "@dev": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    },
    "#database/*.js": {
      "@dev": "./src/database/*.ts",
      "default": "./dist/database/*.js"
    },
    "#docs/*.js": {
      "@dev": "./src/docs/*.ts",
      "default": "./dist/docs/*.js"
    },
    "#middlewares/*.js": {
      "@dev": "./src/middlewares/*.ts",
      "default": "./dist/middlewares/*.js"
    }
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
